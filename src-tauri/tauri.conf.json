{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Game Asset Studio",
  "version": "1.0.0",
  "identifier": "com.game-asset-studio.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Game Asset Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "2D游戏素材聚合搜索与管理工具",
    "longDescription": "Game Asset Studio 是一款桌面端工具，帮助游戏开发者从多个素材网站搜索、下载和管理2D游戏素材。",
    "copyright": "© 2025 Game Asset Studio"
  }
}
